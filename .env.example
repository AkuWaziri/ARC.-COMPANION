# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# Real Email SMTP Delivery settings
# Set up a real SMTP server (such as Gmail app passwords) to deliver login codes directly to inboxes.
SMTP_HOST="smtp.gmail.com"
SMTP_PORT="465"
SMTP_SECURE="true"
SMTP_USER=""
SMTP_PASS=""
SMTP_FROM="Arc Wallet security <your-email@gmail.com>"

# Google OAuth Client Credentials for production-ready sign-in with Gmail
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# Cryptographic Master Password for AES-256 Enclave Encryption of User Credentials
ENCRYPTION_KEY="arc-protocol-aes-encryption-primary-secret-key-256"

# Arc Testnet RPC URL for Foundry
ARC_TESTNET_RPC_URL=

# JWT Secret token signing key
JWT_SECRET="arc-protocol-super-premium-jwt-session-secret-key-92817"


